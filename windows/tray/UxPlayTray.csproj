<Project Sdk="Microsoft.NET.Sdk">

  <!-- System-tray launcher for uxplay.exe.  Targets .NET Framework 4.8, which is
       built into Windows 10 and 11, so users need no extra runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UxPlay</AssemblyName>
    <RootNamespace>UxPlayTray</RootNamespace>
    <ApplicationIcon>uxplay.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>UxPlay</Product>
    <Description>UxPlay AirPlay receiver</Description>
    <Version>1.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <EmbeddedResource Include="uxplay.ico" LogicalName="UxPlayTray.uxplay.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(ReleaseTag)' != ''">
    <!-- set by the release build (-p:ReleaseTag=v1.74-win3); used to tell the user about newer releases -->
    <AssemblyMetadata Include="ReleaseTag" Value="$(ReleaseTag)" />
  </ItemGroup>

  <ItemGroup>
    <!-- lets the project build on machines without the .NET Framework targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
